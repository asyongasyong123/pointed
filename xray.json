{
  "log": {
    "loglevel": "warning",
    "access": "none",
    "error": "none"
  },
  "dns": {
    "servers": ["8.8.8.8", "8.8.4.4"],
    "strategy": "UseIPv4"
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 4,
        "connIdle": 3600,
        "bufferSize": 512
      }
    }
  },
  "inbounds": [
    {
      "port": 10001,
      "listen": "127.0.0.1",
      "protocol": "trojan",
      "tag": "trojan-ws",
      "settings": {
        "clients": [{"password": "xray-2026", "level": 0}]
      },
      "sniffing": {
        "enabled": false
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {"path": "/tr-ws-xray"},
        "sockopt": {
          "tcpNoDelay": true,
          "tcpKeepAlive": true,
          "tcpKeepAliveIdle": 15,
          "tcpKeepAliveInterval": 8,
          "tcpKeepAliveProbes": 3,
          "tcpFastOpen": true
        }
      }
    },
    {
      "port": 10002,
      "listen": "127.0.0.1",
      "protocol": "vless",
      "tag": "vless-ws",
      "settings": {
        "clients": [{"id": "a7b2c9d4-1e3f-4a5b-8c9d-0e1f2a3b4c5d", "level": 0}],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": false
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {"path": "/vl-ws-xray"},
        "sockopt": {
          "tcpNoDelay": true,
          "tcpKeepAlive": true,
          "tcpKeepAliveIdle": 15,
          "tcpKeepAliveInterval": 8,
          "tcpKeepAliveProbes": 3,
          "tcpFastOpen": true
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": {"domainStrategy": "UseIPv4"}
    },
    {
      "protocol": "trojan",
      "tag": "pointed-relay",
      "settings": {
        "servers": [
          {
            "address": "POINTED_SERVER_PLACEHOLDER",
            "port": 443,
            "password": "xray-2026"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "wsSettings": {
          "path": "/tr-ws-xray",
          "headers": {
            "Host": "POINTED_SERVER_PLACEHOLDER"
          }
        },
        "tlsSettings": {
          "serverName": "POINTED_SERVER_PLACEHOLDER",
          "allowInsecure": true
        }
      }
    },
    {
      "protocol": "blackhole",
      "tag": "blocked",
      "settings": {
        "response": {"type": "none"}
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["trojan-ws", "vless-ws"],
        "outboundTag": "TARGET_OUTBOUND_PLACEHOLDER"
      }
    ]
  }
}
